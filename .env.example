# ── Database ──────────────────────────────────────────────
# Local (SQLite) — keep for dev:
# DATABASE_URL="file:./dev.db"
#
# Production (Neon PostgreSQL) — get from Neon Console:
# DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/primebinaryfx?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/primebinaryfx?sslmode=require"

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
# In Vercel, set NEXTAUTH_URL to your production domain

# ── M-Pesa via PayHero ──────────────────────────────────
PAYHERO_USERNAME=your_payhero_api_username
PAYHERO_PASSWORD=your_payhero_api_password
PAYHERO_CHANNEL_ID=your_payhero_channel_id
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
USD_TO_KES=130

# ── Crypto USDT TRC20 Deposits ──────────────────────────
CRYPTO_USDT_ADDRESS=TXforKSJZg7zTLZqzKqFfdvBcVbgvArzyk
CRYPTO_AUTO_CONFIRM=false

# ── Firebase Cloud Messaging (SMS alert app) ─────────────
# Push withdrawal receipts to the native SMS alert app. Credentials must be
# for the SAME Firebase project the app's google-services.json registers
# (project messages-d4c95). Create a service account with the "Firebase
# Cloud Messaging API" role and either paste its JSON (or base64 of it)...
FIREBASE_SERVICE_ACCOUNT=
# ...or set the three fields separately (PRIVATE_KEY keeps \n escaped):
# FIREBASE_PROJECT_ID=messages-d4c95
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@messages-d4c95.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ── Vercel / Next.js ─────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
